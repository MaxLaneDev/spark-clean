    "SparkClean could not read the startup disk's APFS information.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SparkClean לא הצליח לקרוא את פרטי ה-APFS של דיסק האתחול."
          }
        },
        "zh-Hans": {
          "stringUnit": {
