          }
        }
      }
    },
    "Per-path selection checkboxes in Uninstaller — choose exactly which related data to remove": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיבות סימון לפי נתיב ב-Uninstaller - בחר בדיוק אילו נתונים קשורים להסיר"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
