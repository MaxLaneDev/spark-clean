    "The Uninstaller finds all installed apps and their hidden data (caches, preferences, containers). Remove everything with one click.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלי הסרת היישומים מאתר יישומים מותקנים ואת הנתונים הנסתרים שלהם (מטמונים, העדפות וקונטיינרים), ומאפשר להסיר הכול בלחיצה אחת."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载程序会查找所有已安装的应用程序及其隐藏数据（缓存、首选项、容器）。一键删除所有内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストーラーは、インストールされているすべてのアプリとその非表示データ (キャッシュ、設定、コンテナー) を検索します。ワンクリックですべてを削除します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Uninstaller findet alle installierten Apps und deren versteckte Daten (Caches, Einstellungen, Container). Entfernen Sie alles mit einem Klick."
          }
        }
      }
    },
    "The application did not quit within five seconds.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה לא נסגרה תוך חמש שניות."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用程序在五秒内没有退出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションは 5 秒以内に終了しませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anwendung wurde nicht innerhalb von fünf Sekunden beendet."
          }
        }
      }
    },
    "The application is managed by a file provider.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה מנוהלת על ידי ספק קבצים."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该应用程序由文件提供商管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションはファイル プロバイダーによって管理されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anwendung wird von einem Dateianbieter verwaltet."
          }
        }
      }
    },
    "The application refused to quit.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה סירבה להיסגר."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用程序拒绝退出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションが終了を拒否しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Antrag wurde abgelehnt."
          }
        }
      }
    },
    "The disk analyzer finished without a usable Data-volume result.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנתח הדיסק סיים ללא תוצאה שמישה עבור אמצעי האחסון Data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘分析器结束时没有可用的数据量结果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク アナライザーは、使用可能なデータ ボリュームの結果を取得せずに終了しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Festplattenanalysator wurde ohne ein brauchbares Datenvolumen-Ergebnis beendet."
          }
        }
      }
    },
    "The dropped app is in a protected, cloud-managed, mounted, or symlinked location.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום שנגרר נמצא במיקום מוגן, מנוהל בענן, רכוב או מקושר באמצעות קישור סמלי."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除的应用程序位于受保护的、云管理的、已安装的或符号链接的位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドロップされたアプリは、保護された、クラウド管理された、マウントされた、またはシンボリックリンクされた場所にあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die abgelegte App befindet sich an einem geschützten, in der Cloud verwalteten, gemounteten oder symbolisch verknüpften Speicherort."
          }
        }
      }
    },
    "The item may be in use or require different permissions.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שהפריט נמצא בשימוש או דורש הרשאות שונות."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该项目可能正在使用或需要不同的权限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイテムが使用中であるか、別の権限が必要である可能性があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Element wird möglicherweise verwendet oder erfordert andere Berechtigungen."
          }
        }
      }
    },
    "The selected snapshots are still present.": {
      "localizations": {
        "he": {
