    "Trash failure no longer silently falls back to permanent deletion": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשל בהעברה לאשפה כבר לא מוביל בשקט למחיקה לצמיתות"
          }
        },
        "zh-Hans": {
