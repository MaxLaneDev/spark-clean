    "": {
      "shouldTranslate": false
    },
    "\n\n%@ was moved to Trash and is still using disk space. Empty Trash to reclaim that space, or restore the cleanup before emptying it.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$@ הועבר לאשפה ועדיין תופס שטח בדיסק. יש לרוקן את האשפה כדי לפנות את השטח, או לשחזר את הניקוי לפני הריקון."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\n\n%1$@ was moved to Trash and is still using disk space. Empty Trash to reclaim that space, or restore the cleanup before emptying it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$@ 已移至废纸篓并且仍在使用磁盘空间。清空废纸篓以回收该空间，或恢复清空之前的清理工作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$@ はゴミ箱に移動されましたが、まだディスク領域を使用しています。ゴミ箱を空にしてそのスペースを再利用するか、空にする前にクリーンアップを復元します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$@ wurde in den Papierkorb verschoben und belegt immer noch Speicherplatz. Leeren Sie den Papierkorb, um diesen Speicherplatz freizugeben, oder stellen Sie die Bereinigung wieder her, bevor Sie ihn leeren."
          }
        }
      }
    },
    "\n\n%@ was permanently removed.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$@ נמחק לצמיתות."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\n\n%1$@ was permanently removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$@ 已永久删除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$@ は完全に削除されました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$@ wurde dauerhaft entfernt."
          }
        }
      }
    },
    "\n\n%lld cleanup issue(s) were reported.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nמספר בעיות הניקוי שדווחו: %1$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\n\n%1$lld cleanup issue(s) were reported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n报告了%1$lld清理问题。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$lld クリーンアップの問題が報告されました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$lld Bereinigungsprobleme wurden gemeldet."
          }
        }
      }
    },
    "\n\n%lld selected group(s) are visual matches, not byte-identical files. Review every path before continuing.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$lld מהקבוצות שנבחרו הן התאמות חזותיות, ולא קבצים זהים ברמת הבייטים. יש לבדוק כל נתיב לפני שממשיכים."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\n\n%1$lld selected group(s) are visual matches, not byte-identical files. Review every path before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$lld 所选组是视觉匹配，而不是字节相同的文件。在继续之前检查每条路径。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$lld 選択されたグループは視覚的に一致しますが、バイトが同一のファイルではありません。続行する前に、すべてのパスを確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n%1$lld ausgewählte Gruppen sind visuelle Übereinstimmungen, keine byteidentischen Dateien. Überprüfen Sie jeden Pfad, bevor Sie fortfahren."
          }
        }
      }
    },
    "\n\nSome tasks require your admin password.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nמשימות מסוימות דורשות את סיסמת המנהל שלך."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n有些任务需要您的管理员密码。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n一部のタスクには管理者パスワードが必要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nFür einige Aufgaben ist Ihr Administratorkennwort erforderlich."
          }
        }
      }
    },
    "\n...and %lld more": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\n...ועוד %1$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\n...and %1$lld more"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n...以及%1$lld更多"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n...そして %1$lld 詳細"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n...und %1$lld mehr"
          }
        }
      }
    },
    " %lld conflict(s) remain available to retry.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " נותרו %1$lld התנגשויות שאפשר לנסות שוב."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": " %1$lld conflict(s) remain available to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld 冲突仍可重试。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld 競合は引き続き再試行できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld Konflikte bleiben für einen erneuten Versuch verfügbar."
          }
        }
      }
    },
    " %lld item(s) failed validation or could not be restored.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld פריטים נכשלו באימות או שלא ניתן היה לשחזר אותם."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": " %1$lld item(s) failed validation or could not be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld 项目验证失败或无法恢复。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld アイテムは検証に失敗したか、復元できませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld Elemente konnten nicht validiert oder wiederhergestellt werden."
          }
        }
      }
    },
    " %lld item(s) were no longer in Trash.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld פריטים כבר לא היו באשפה."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": " %1$lld item(s) were no longer in Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld 项目不再位于废纸篓中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld アイテムはゴミ箱にありませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " %1$lld Elemente befanden sich nicht mehr im Papierkorb."
          }
        }
      }
    },
