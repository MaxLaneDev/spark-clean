    "Admin privilege escalation — clean root-owned files, uninstall system apps (e.g., Microsoft Office), and Trash Monitor cleanup": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שימוש בהרשאות מנהל — ניקוי קבצים בבעלות root, הסרת יישומי מערכת (למשל Microsoft Office) וניקוי באמצעות מנטר האשפה"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理员权限升级 - 清理 root 拥有的文件、卸载系统应用程序（例如 Microsoft Office）和垃圾监视器清理"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者権限の昇格 — ルート所有ファイルのクリーンアップ、システム アプリ (Microsoft Office など) のアンインストール、ゴミ箱モニターのクリーンアップ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eskalation der Administratorrechte – Bereinigen von Root-Dateien, Deinstallieren von Systemanwendungen (z. B. Microsoft Office) und Bereinigung des Papierkorbmonitors"
          }
        }
      }
    },
