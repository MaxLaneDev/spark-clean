    "WhatsApp diagnostic logs — review first if you are troubleshooting the app": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יומני אבחון של WhatsApp — יש לבדוק תחילה בעת פתרון תקלה ביישום"
          }
        },
        "zh-Hans": {
          "stringUnit": {
