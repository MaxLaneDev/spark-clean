    "GitHub is used only for optional release checks and user-requested downloads. SparkClean does not integrate with advertising networks or analytics platforms.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub משמש רק לבדיקות מהדורה אופציונליות ולהורדות שהמשתמש ביקש. SparkClean אינו משתלב עם רשתות פרסום או עם פלטפורמות ניתוח."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 仅用于可选的版本检查和用户请求的下载。 SparkClean 不与广告网络或分析平台集成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub は、オプションのリリース チェックとユーザーが要求したダウンロードにのみ使用されます。 SparkClean は、広告ネットワークや分析プラットフォームと統合しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub wird nur für optionale Release-Prüfungen und vom Benutzer angeforderte Downloads verwendet. SparkClean lässt sich nicht in Werbenetzwerke oder Analyseplattformen integrieren."
          }
        }
      }
    },
