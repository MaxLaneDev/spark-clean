      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיכומי התיקיות חופפים בסכום זה; APFS מאחסן את הבלוקים המשותפים פעם אחת בלבד."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹总数重叠此数量； APFS 仅存储共享块一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダーの合計はこの量だけ重複します。 APFS は共有ブロックを 1 回だけ保存します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ordnersummen überschneiden sich um diesen Betrag; APFS speichert die gemeinsam genutzten Blöcke nur einmal."
          }
        }
      }
    },
    "Folder values are allocated-size estimates. APFS volume totals above are authoritative.": {
      "localizations": {
        "he": {
