    "App data or system files — could cause issues if deleted.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני אפליקציה או קובצי מערכת — עלולים לגרום לבעיות אם יימחקו."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用程序数据或系统文件 - 如果删除可能会导致问题。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ データまたはシステム ファイル - 削除すると問題が発生する可能性があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Daten oder Systemdateien – könnten beim Löschen Probleme verursachen."
          }
        }
      }
    },
    "App resume data — removing it can discard restored windows or session state": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני שחזור מצב היישום — הסרתם עלולה למחוק חלונות ששוחזרו או את מצב ההפעלה"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用状态恢复数据 — 移除后可能会丢失恢复的窗口或会话状态"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの状態復元データ — 削除すると、復元されたウインドウやセッション状態が失われる場合があります"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten zur App-Wiederherstellung – beim Entfernen können wiederhergestellte Fenster oder Sitzungsdaten verloren gehen"
          }
        }
      }
    },
