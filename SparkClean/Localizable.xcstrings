    "New Disk Map — accounts for the whole startup volume instead of showing cleanup results as total disk usage": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפת דיסק חדשה — מציגה את כל השימוש בנפח האתחול במקום להציג את תוצאות הניקוי כשימוש הכולל בדיסק"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新磁盘映射 - 考虑整个启动卷，而不是将清理结果显示为总磁盘使用量"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいディスク マップ — クリーンアップ結果を合計ディスク使用量として表示するのではなく、起動ボリューム全体を考慮します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Festplattenzuordnung – berücksichtigt das gesamte Startvolume, anstatt die Bereinigungsergebnisse als gesamte Festplattennutzung anzuzeigen"
          }
        }
      }
    },
    "New Maintenance view — run system maintenance tasks like flushing DNS, purging memory, and rebuilding indexes": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תצוגת תחזוקה חדשה — הפעל משימות מערכת כגון ניקוי מטמון DNS, פינוי זיכרון ובנייה מחדש של אינדקסים"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的维护视图 — 运行系统维护任务，例如刷新 DNS、清除内存和重建索引"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいメンテナンス ビュー — DNS のフラッシュ、メモリのパージ、インデックスの再構築などのシステム メンテナンス タスクを実行します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Wartungsansicht – Führen Sie Systemwartungsaufgaben wie DNS-Leeren, Speicherlöschen und Neuerstellen von Indizes aus"
          }
        }
      }
    },
    "New Privacy category — scan and clean Recent Items, Spotlight History, Shell History, Safari/Chrome/Firefox browsing data, and cookies": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטגוריית פרטיות חדשה - סרוק ונקה פריטים אחרונים, היסטוריית Spotlight, היסטוריית מעטפת, נתוני גלישה של Safari/Chrome/Firefox וקובצי Cookie"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的隐私类别 - 扫描和清理最近的项目、Spotlight 历史记录、Shell 历史记录、Safari/Chrome/Firefox 浏览数据和 cookie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいプライバシー カテゴリ - 最近のアイテム、Spotlight履歴、シェル履歴、Safari/Chrome/Firefox の閲覧データ、Cookie のスキャンとクリーンアップ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
