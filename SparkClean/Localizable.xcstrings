            "value": "SparkClean は起動ディスクの APFS 情報を読み取ることができませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SparkClean konnte die APFS-Informationen des Startvolumes nicht lesen."
          }
        }
      }
    },
    "SparkClean could not save your language preference.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SparkClean לא הצליח לשמור את העדפת השפה שלך."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
