    "APFS clones are no longer counted twice, so reported sizes match real reclaimable space": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיבוטים של APFS כבר לא נספרים פעמיים, כך שהגדלים המדווחים תואמים לשטח האמיתי שניתן לפינוי"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 克隆不再计算两次，因此报告的大小与实际可回收空间匹配"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS クローンは 2 回カウントされなくなり、報告されるサイズは実際の再利用可能なスペースと一致します"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS-Klone werden nicht mehr doppelt gezählt, sodass die gemeldeten Größen mit dem tatsächlich zurückgewinnbaren Speicherplatz übereinstimmen"
          }
        }
      }
    },
    "APFS container metadata": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מטא-נתונים של קונטיינר APFS"
