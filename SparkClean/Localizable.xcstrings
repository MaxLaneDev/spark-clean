    "%@ currently owns selected cache or privacy data. Quit Apps & Clean waits up to five seconds; anything still running is skipped.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ משתמש כרגע בנתוני המטמון או הפרטיות שנבחרו. האפשרות צא מיישומים ונקה ממתינה עד חמש שניות; כל יישום שעדיין פועל ידולג."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ currently owns selected cache or privacy data. Quit Apps & Clean waits up to five seconds; anything still running is skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 当前拥有选定的缓存或隐私数据。退出应用程序并清理最多等待五秒；任何仍在运行的内容都会被跳过。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は現在、選択されたキャッシュ データまたはプライバシー データを所有しています。 「アプリを終了してクリーンアップ」は最大 5 秒間待機します。まだ実行中のものはスキップされます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ besitzt derzeit ausgewählte Cache- oder Datenschutzdaten. Das Beenden von Apps & Clean wartet bis zu fünf Sekunden; alles, was noch läuft, wird übersprungen."
          }
        }
      }
    },
