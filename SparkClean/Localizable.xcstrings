          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadaten des APFS-Containers"
          }
        }
      }
    },
    "APFS defragmentation enabled — macOS will compact eligible files in the background": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
