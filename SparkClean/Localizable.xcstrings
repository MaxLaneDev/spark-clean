    "Low-risk cleanup — caches, logs, and generated files that are expected to rebuild automatically.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניקוי בסיכון נמוך - מטמונים, יומנים וקבצים שנוצרו שצפויים להיבנות מחדש באופן אוטומטי."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低风险清理——缓存、日志和生成的文件预计会自动重建。"
          }
