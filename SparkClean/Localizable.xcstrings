          "stringUnit": {
            "state": "translated",
            "value": "復元する最近のクリーンアップはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine aktuelle Bereinigung zum Wiederherstellen."
          }
        }
      }
    },
    "These stores grow over time but usually shouldn't be bulk-deleted. This view only measures — nothing here is removed.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאגרי הנתונים האלה גדלים עם הזמן, אך בדרך כלל אין למחוק אותם בבת אחת. תצוגה זו מודדת בלבד — דבר אינו מוסר מכאן."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些存储位置会随时间增大，但通常不应批量删除。此视图只进行测量，不会删除任何内容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの保存領域は時間とともに大きくなりますが、通常は一括削除すべきではありません。この画面では容量を測定するだけで、削除は行いません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Speicherorte wachsen mit der Zeit, sollten aber normalerweise nicht gesammelt gelöscht werden. Diese Ansicht misst nur; hier wird nichts entfernt."
          }
        }
      }
    },
    "Third-Party Services": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירותי צד שלישי"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三方服务"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サードパーティのサービス"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dienste Dritter"
          }
        }
      }
    },
    "Third-party command-line tools": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלי שורת פקודה של צד שלישי"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第三方命令行工具"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
