    "%lld local snapshot(s) will be deleted via tmutil. This may make snapshot-backed space available and requires administrator privileges. Your Time Machine backups on external drives are not affected.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld תמונות מצב מקומיות יימחקו באמצעות ⁦tmutil⁩. הפעולה עשויה לפנות שטח שמגובה בתמונות מצב ודורשת הרשאות מנהל. גיבויי Time Machine בכוננים חיצוניים לא יושפעו."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld local snapshot(s) will be deleted via tmutil. This may make snapshot-backed space available and requires administrator privileges. Your Time Machine backups on external drives are not affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 本地快照将通过 tmutil 删除。这可能会使快照支持的空间可用并且需要管理员权限。您在外部驱动器上的 Time Machine 备份不受影响。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ローカル スナップショットは tmutil 経由で削除されます。これにより、スナップショットにバックアップされた領域が使用可能になる可能性があり、管理者権限が必要になります。外部ドライブ上の Time Machine バックアップは影響を受けません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lokale Snapshot(s) werden über tmutil gelöscht. Dadurch wird möglicherweise durch Snapshots gesicherter Speicherplatz verfügbar und erfordert Administratorrechte. Ihre Time Machine-Backups auf externen Laufwerken sind nicht betroffen."
          }
        }
      }
    },
