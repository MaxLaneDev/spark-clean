            "state": "translated",
            "value": "ゴミ箱の失敗がサイレントに永久削除に戻らなくなりました"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ausfall des Papierkorbs führt nicht mehr automatisch zu einer dauerhaften Löschung"
          }
        }
      }
    },
    "TrashMonitor thread safety improvements with OSAllocatedUnfairLock": {
      "localizations": {
        "he": {
          "stringUnit": {
