    "Items already in your Trash — empty to reclaim space": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים שכבר נמצאים באשפה — רוקן אותה כדי לפנות שטח"
          }
        },
        "zh-Hans": {
          "stringUnit": {
