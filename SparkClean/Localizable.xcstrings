    "Some macOS-owned locations could not be read. Their usage remains in Protected & APFS-managed space.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא חלק מהמיקומים שבבעלות macOS. השטח שלהם נשאר תחת שטח מוגן ומנוהל על ידי APFS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取某些 macOS 拥有的位置。它们的使用仍然在受保护和 APFS 管理的空间中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の macOS が所有する場所を読み取ることができませんでした。それらの使用は、保護された APFS 管理のスペースに残ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige macOS-eigene Speicherorte konnten nicht gelesen werden. Ihre Nutzung bleibt im geschützten und von APFS verwalteten Bereich."
          }
        }
      }
    },
